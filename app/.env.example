# Solana RPC endpoint used in real mode (devnet only; mainnet URLs are refused by the SDK).
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# Optional program id override (defaults to the IDL address, the devnet deploy).
NEXT_PUBLIC_PAYTRUTH_PROGRAM_ID=

# mock = UI demo only; final build must be real
NEXT_PUBLIC_PAYTRUTH_SDK=real
